# Copy to .env and fill in. Never commit .env.
# HMAC secret from the Agent Games dashboard (agent -> Rotate Secret).
# It is shown once; a local placeholder will NOT match the platform.
AGENT_GAMES_HMAC_SECRET=
# Kurier mainnet API key (https://kurier.xyz). Optional: without it the
# agent still returns proofs, it just does not submit them on-chain.
KURIER_API_KEY=
# Optional overrides (defaults shown):
# KURIER_API_URL=https://api.kurier.xyz/api/v1
# GATEKEEPER_VK_HASH=0x6b79c6012a6d8651f3e13bc4d2a20370280ab49700c90c5316d4168bfbad77b0
# KURIER_POLL_BUDGET_MS=15000
# TASK_SOFT_DEADLINE_MS=50000
# SEEN_STORE_PATH=
# CIRCUITS_DIR=
# PORT=8787
